diff --git a/WheelWizard/Services/Launcher/LocalVrLauncher.cs b/WheelWizard/Services/Launcher/LocalVrLauncher.cs
new file mode 100644
index 0000000..ee4c4c3
--- /dev/null
+++ b/WheelWizard/Services/Launcher/LocalVrLauncher.cs
@@ -0,0 +1,85 @@
+using System.Diagnostics;
+using WheelWizard.Models.Enums;
+using WheelWizard.Mods;
+
+namespace WheelWizard.Services.Launcher;
+
+// Local VR products are maintained with their translated code and matching pack.
+// Never reconcile them through the upstream non-VR setup/updater.
+public sealed class LocalVrLauncher(string title, string executableRelativePath, IModsLaunchService? mods = null) : ILauncher
+{
+    private static readonly SemaphoreSlim LaunchGate = new(1, 1);
+    public static bool IsLocalBundle => File.Exists(Path.Combine(AppContext.BaseDirectory, "vr-local.txt"));
+    public static string BundleRoot => Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, ".."));
+    public static string RuntimeDirectory => Path.Combine(BundleRoot, "Install");
+    public string GameTitle => title;
+    private string Executable => Path.Combine(RuntimeDirectory, executableRelativePath);
+
+    public Task<WheelWizardStatus> GetCurrentStatus() =>
+        Task.FromResult(
+            File.Exists(Executable) && Directory.Exists(Path.Combine(RuntimeDirectory, "GameAssets", "DATA"))
+                ? WheelWizardStatus.Ready
+                : WheelWizardStatus.NotInstalled
+        );
+
+    public async Task<OperationResult> Install() => await RunSetup();
+
+    public async Task<OperationResult> Update() => await RunSetup();
+
+    public async Task<OperationResult> Launch()
+    {
+        if (!await LaunchGate.WaitAsync(0))
+            return Fail("A VR game is already running from Wheel Wizard.");
+        try
+        {
+            if (!File.Exists(Executable))
+                return Fail("VR executable is missing: " + Executable);
+            if (mods is not null)
+            {
+                // This directory starts empty in the bundle and is exclusively
+                // managed by Wheel Wizard's enabled-mod list. Pack assets stay
+                // in their other original directories.
+                var patches = Path.Combine(BundleRoot, "RetroRewind6", "Patches");
+                var prepared = await mods.PrepareModsForLaunch(patches, clearTargetFolderWhenNoEnabledMods: true);
+                if (prepared.IsFailure)
+                    return prepared;
+            }
+            using var process = Process.Start(
+                new ProcessStartInfo(Executable) { WorkingDirectory = Path.GetDirectoryName(Executable)!, UseShellExecute = false }
+            );
+            if (process is null)
+                return Fail("The VR game could not be started.");
+            await process.WaitForExitAsync();
+            return process.ExitCode == 0 ? Ok() : Fail($"The VR game exited with code {process.ExitCode}. See QuestVR/UserData/Logs.");
+        }
+        catch (Exception exception)
+        {
+            return Fail("VR launch failed: " + exception.Message);
+        }
+        finally
+        {
+            LaunchGate.Release();
+        }
+    }
+
+    private async Task<OperationResult> RunSetup()
+    {
+        var setup = Path.Combine(BundleRoot, "WiiCompiled-VR-Setup.exe");
+        if (!File.Exists(setup))
+            return Fail("WiiCompiled-VR-Setup.exe is missing from the portable folder.");
+        try
+        {
+            using var process = Process.Start(new ProcessStartInfo(setup) { UseShellExecute = true });
+            if (process is null)
+                return Fail("The VR setup could not be started.");
+            await process.WaitForExitAsync();
+            return await GetCurrentStatus() == WheelWizardStatus.Ready
+                ? Ok()
+                : Fail("Installation is not complete. Run setup again and select your clean PAL RMCP01 disc image.");
+        }
+        catch (Exception exception)
+        {
+            return Fail("VR setup failed: " + exception.Message);
+        }
+    }
+}
