+
+bool refresh_vr_menu(const AuroraStereoFrame& frame) noexcept {
+  if (frame.mode != AURORA_STEREO_FRAME_VIRTUAL_SCREEN || !frame.ui.anchored || frame.frameToken == 0)
+    return false;
+  // The producer may be sealing the next menu frame while OpenXR asks for a
+  // fresh headset pose. Never read a half-updated source or resize an eye that
+  // the frame worker is still encoding.
+  std::lock_guard gpuLock(g_rendererGpuMutex);
+  std::lock_guard menuLock(g_vrMenuRefreshMutex);
+  if (frame.contentTag == AURORA_STEREO_CONTENT_TAG_UNKNOWN ||
+      frame.contentTag != g_vrMenuSourceTag || !g_vrMenuSource.bindGroup)
+    return false;
+
+  for (uint32_t eye = 0; eye < AURORA_STEREO_EYE_COUNT; ++eye) {
+    if (frame.eyes[eye].width == 0 || frame.eyes[eye].height == 0) return false;
+    ensure_stereo_eye_target(eye, frame.eyes[eye].width, frame.eyes[eye].height);
+    g_stereoOutputSizes[eye] = {frame.eyes[eye].width, frame.eyes[eye].height};
+  }
+  AuroraVRUiGuide layout{};
+  { std::lock_guard lock(vrui::mutex); layout = vrui::guide; }
+  const wgpu::CommandEncoderDescriptor descriptor{.label = "VR menu refresh"};
+  auto encoder = g_device.CreateCommandEncoder(&descriptor);
+  for (uint32_t eye = 0; eye < AURORA_STEREO_EYE_COUNT; ++eye)
+    vrui::render(encoder, g_vrMenuSource, frame, layout, eye);
+  const auto sink = run_stereo_sink(encoder, frame.frameToken, gfx::current_frame(), frame.mode);
+  if (!sink) return false;
+  const auto buffer = encoder.Finish();
+  {
+    std::lock_guard submitLock(g_queueSubmitMutex);
+    g_queue.Submit(1, &buffer);
+    if (sink->submitted) sink->submitted(sink->frame, sink->userdata);
+  }
+  return true;
+}
