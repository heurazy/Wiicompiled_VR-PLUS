+TEST(StereoReplayTest, MinimapPortraitAndShadowsRemainDistinctInFloatDepth) {
+  // Original Race.szs: portrait Z=0, shadows Z=-0.01, local searchlight Z=-0.02.
+  // A 1000-unit UI depth window produces 1e-5 normalized separation.
+  const float portrait = 0.5f;
+  const float shadow = portrait - 0.01f / 1000.0f;
+  const float searchlight = portrait - 0.02f / 1000.0f;
+  EXPECT_FLOAT_EQ(0.5f + (portrait - 0.5f) * 0.00001f,
+                  0.5f + (shadow - 0.5f) * 0.00001f);
+  for (float panel : {0.0001f, 0.01f, 0.1f, 0.5f, 0.9f}) {
+    const float colorDepth = hud_layer_depth(panel, portrait);
+    const float shadowDepth = hud_layer_depth(panel, shadow);
+    const float lightDepth = hud_layer_depth(panel, searchlight);
+    // Shadows are submitted after the portrait. Even LEQUAL in guest Z
+    // (GreaterEqual in reversed Z) must reject them over the colored pixels.
+    EXPECT_LT(shadowDepth, std::nextafter(std::nextafter(colorDepth, 0.f), 0.f));
+    EXPECT_LT(lightDepth, shadowDepth);
+  }
+}
+
+TEST(StereoReplayTest, HudLayerOrderingRetainsPhysicalHandOcclusion) {
+  for (float distance : {0.4f, 1.0f, 2.0f, 10.0f}) {
