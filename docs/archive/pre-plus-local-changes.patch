+void aurora_set_stereo_hud_world_depth(float distance) {
+  distance = std::isfinite(distance) && distance > 0.f ? distance : 0.f;
+  if (aurora::gfx::get_stereo_hud_world_depth() == distance) {
+    return;
+  }
+  // GX commands are buffered: consume the previous control's draws with its
+  // original HUD placement before changing the metadata for the next control.
+  aurora::gx::fifo::drain();
+  aurora::gfx::set_stereo_hud_world_depth(distance);
+  aurora::gx::g_gxState.stateDirty = true;
+}
+void aurora_set_stereo_hud_world_anchor(float x, float y) {
+  x = std::isfinite(x) ? x : 0.f;
+  y = std::isfinite(y) ? y : 0.f;
+  const auto oldAnchor = aurora::gfx::get_stereo_hud_world_anchor();
+  if (oldAnchor.first == x && oldAnchor.second == y) {
+    return;
+  }
+  aurora::gx::fifo::drain();
+  aurora::gfx::set_stereo_hud_world_anchor(x, y);
+  // Identical GX material state must not merge two differently placed labels.
+  aurora::gx::g_gxState.stateDirty = true;
+}
