+    const float nearerHand = 0.1f / (distance * 0.95f);
+    const float fartherHand = 0.1f / (distance * 1.05f);
+    for (float authoredDepth : {0.0f, 0.5f, 1.0f}) {
+      const float hud = hud_layer_depth(panel, authoredDepth);
+      EXPECT_GT(nearerHand, hud);
+      EXPECT_LT(fartherHand, hud);
+    }
+  }
+}
