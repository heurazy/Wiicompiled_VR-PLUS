+    result[0] = tiltedRight.x; result[1] = tiltedUp.x; result[2] = pitchedForward.x;
+    result[4] = tiltedRight.y; result[5] = tiltedUp.y; result[6] = pitchedForward.y;
+    result[8] = tiltedRight.z; result[9] = tiltedUp.z; result[10] = pitchedForward.z;
