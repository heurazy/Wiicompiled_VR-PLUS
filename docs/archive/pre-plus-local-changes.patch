+
+    for (int frame=0; frame<8; ++frame)
+        Check(filter.Update(stable,pitched(0.35f),false,1.0f/60.0f,result),
+              "safe tilt accepts a brief steep bump");
+    CheckNear(result[6],0,"safe tilt ignores a short steep bump",0.001f);
+    for (int frame=0; frame<60; ++frame)
+        filter.Update(stable,pitched(0.35f),false,1.0f/60.0f,result);
+    Check(result[6]>0.08f && result[6]<std::sin(0.35f),
