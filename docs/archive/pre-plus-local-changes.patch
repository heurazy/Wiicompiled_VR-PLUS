+    const float worldConstant = 0.2f * unitsPerMeter;
+    const auto worldPlane = hud_depth_plane(0.0f, worldConstant, unitsPerMeter, false);
+    const auto handPlane = hud_depth_plane(0.0f, worldConstant, unitsPerMeter, true);
+    const float worldHudDepth = worldPlane.offset + worldPlane.reciprocalW / (2.0f * unitsPerMeter);
+    const float handHudDepth = handPlane.offset + handPlane.reciprocalW / 2.0f;
+    const float handDepth = handPlane.offset + handPlane.reciprocalW / 0.4f;
+    EXPECT_NEAR(worldHudDepth, handHudDepth, 1e-6f);
